---
import "@fontsource-variable/geist/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/docs.css";
import { navigation, upstream, docsRepo, release } from "../data/navigation";
const { title, description, toc = [] } = Astro.props;
const here = Astro.url.pathname;
const entries = navigation.flatMap((group) => group.pages);
const pos = entries.findIndex((p) => p.href === here);
const currentGroup = navigation.find((g) =>
  g.pages.some((p) => p.href === here),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · Clink CLI Docs</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161918" />
    <link rel="icon" href="/clink.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="top">
      <div class="top-inner">
        <a class="wordmark" href="/" aria-label="Clink CLI documentation home">
          <img src="/clink.svg" width="34" height="34" alt="" />
          <strong>
            clink<span>-cli</span>
          </strong>
        </a>
        <span class="head-divider" aria-hidden="true">
          /
        </span>
        <span class="docs-name">Docs</span>
        <a class="github" href={upstream}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <div class="shell">
      <aside class="sidebar">
        <nav aria-label="Documentation">
          {navigation.map((group) => (
            <div class="nav-group">
              <p>{group.label}</p>
              {group.pages.map((p) => (
                <a
                  href={p.href}
                  aria-current={p.href === here ? "page" : undefined}
                >
                  {p.title}
                </a>
              ))}
            </div>
          ))}
        </nav>
        <div class="side-bottom">
          <a href="https://pypi.org/project/clink-cli/">Package on PyPI ↗</a>
          <a href={docsRepo}>Documentation source ↗</a>
        </div>
      </aside>
      <div class="content-zone">
        <details class="mobile-nav">
          <summary>Browse documentation</summary>
          <nav aria-label="Mobile documentation">
            {entries.map((p) => (
              <a
                href={p.href}
                aria-current={p.href === here ? "page" : undefined}
              >
                {p.title}
              </a>
            ))}
          </nav>
        </details>
        <main id="main">
          <div class="crumb">
            {currentGroup?.label ?? "Documentation"} <span>/</span> {title}
          </div>
          <h1>{title}</h1>
          <p class="deck">{description}</p>
          <slot />
          {pos >= 0 && (
            <nav class="pagination" aria-label="Previous and next pages">
              {entries[pos - 1] && (
                <a href={entries[pos - 1].href}>
                  <small>← Previous</small>
                  {entries[pos - 1].title}
                </a>
              )}
              {entries[pos + 1] && (
                <a href={entries[pos + 1].href}>
                  <small>Next →</small>
                  {entries[pos + 1].title}
                </a>
              )}
            </nav>
          )}
        </main>
      </div>
      <aside class="right">
        {toc.length > 0 && (
          <nav aria-label="On this page">
            <p>On this page</p>
            {toc.map(([id, text]: [string, string]) => (
              <a href={"#" + id}>{text}</a>
            ))}
          </nav>
        )}
        <a class="version" href={upstream + "/blob/main/CHANGELOG.md"}>
          Release {release} ↗
        </a>
      </aside>
    </div>
    <div role="status" id="copy-status" class="sr"></div>
  </body>
</html>
